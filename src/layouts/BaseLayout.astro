---
// Layout principal que envuelve todas las páginas
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import "../styles/main.scss";

interface Props {
    title: string;
    description?: string;
    ogImage?: string;
    canonical?: URL | string;
}

const {
    title,
    description = "Desarrollador Full Stack — Landing pages profesionales en 24-72h desde $50 USD",
    ogImage = "/img/banner.webp",
    canonical,
} = Astro.props;

const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content={description} />
        <meta name="generator" content={Astro.generator} />

        <!-- Preload fuente local -->
        <link
            rel="preload"
            href="/fonts/inter-variable.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />

        <!-- Open Graph -->
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1252" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:type" content="image/webp" />
        <meta property="og:url" content={String(canonicalURL)} />
        <meta property="og:site_name" content="LandingPro" />
        <meta property="og:type" content="website" />
        <meta property="og:locale" content="es_ES" />

        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImage} />

        <!-- Schema.org ProfessionalService -->
        <script type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@type": ["ProfessionalService", "Person"],
                "name": "LandingPro – Luis Enrique Ferrer",
                "alternateName": "Luis Enrique",
                "jobTitle": "Desarrollador Full Stack",
                "description": "Desarrollador Full Stack especializado en landing pages profesionales para negocios y emprendedores.",
                "email": "l.enrique1909@gmail.com",
                "telephone": "+5355055789",
                "url": "https://luisenrique.dev",
                "areaServed": "Worldwide",
                "priceRange": "$50 - $200 USD",
                "sameAs": [
                    "https://wa.me/5355055789",
                    "https://t.me/HACKERMATR1X",
                    "https://www.linkedin.com/in/luis-enrique-ferrer-1889851b4"
                ],
                "hasOfferCatalog": {
                    "@type": "OfferCatalog",
                    "name": "Servicios de desarrollo web",
                    "itemListElement": [
                        {
                            "@type": "Offer",
                            "name": "Landing page básica",
                            "price": "50",
                            "priceCurrency": "USD"
                        },
                        {
                            "@type": "Offer",
                            "name": "Landing page avanzada",
                            "price": "120",
                            "priceCurrency": "USD"
                        }
                    ]
                }
            }
        </script>

        <link rel="canonical" href={canonicalURL} />
        <link rel="icon" type="image/png" href="/favicon.png" />

        <title>{title}</title>
    </head>
    <body>
        <a href="#main-content" class="skip-link visually-hidden"
            >Saltar al contenido principal</a
        >
        <Header />
        <main id="main-content">
            <slot />
        </main>
        <Footer />
    </body>
</html>
