---
import { Icon } from "astro-icon/components";

const items = [
    {
        icon: "lucide:zap",
        title: "Experiencia real, entregas rápidas",
        description:
            "Mi tiempo trabajando con clientes reales y el dominio de herramientas que aceleran mi proceso me permiten entregar en 1-3 días sin sacrificar calidad.",
    },
    {
        icon: "lucide:palette",
        title: "Diseño que se ve profesional",
        description:
            "No uso plantillas genéricas. Cada landing tiene paleta de colores, tipografía e imágenes pensadas para tu marca.",
    },
    {
        icon: "lucide:trending-up",
        title: "Optimizada para resultados",
        description:
            "SEO técnico, meta tags, Page Speed en verde y estructura semántica. Google y tus clientes lo notarán.",
    },
];
---

<section
    class="features section"
    id="por-que-yo"
    aria-labelledby="features-title"
>
    <div class="container">
        <div class="features__header">
            <h2 id="features-title">¿Por qué trabajar conmigo?</h2>
            <p>
                No solo entrego código — entrego resultados medibles que pueden
                hacer crecer tu negocio y atraer clientes.
            </p>
        </div>

        <div class="features__grid">
            {
                items.map((item) => (
                    <article class="card">
                        <div class="card__icon" aria-hidden="true">
                            <Icon name={item.icon} width={24} height={24} />
                        </div>
                        <h3 class="card__title">{item.title}</h3>
                        <p class="card__description">{item.description}</p>
                    </article>
                ))
            }
        </div>
    </div>
</section>
